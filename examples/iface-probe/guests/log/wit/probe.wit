// Probe world: log only, so the component instantiates as soon as the host
// binds `qqq:log`.
package qqq:iface-probe-log@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-log: func() -> string;
}

world probe {
  import qqq:log/logging@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
