{
  "$defs": {
    "AiCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#AiCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `AiCapability` table.",
      "properties": {
        "models": {
          "description": "Model allowlist with size bounds, e.g. `*:<=4B`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "providers": {
          "description": "Provider selectors, e.g. `local:ggml`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "qqq-toml#AiCapability",
      "type": "object"
    },
    "Build": {
      "$id": "https://qqq.codes/schema/qqq-toml#Build",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Build` table.",
      "properties": {
        "language": {
          "description": "Source language: `rust`, `ts`, `go`, `python` or `cpp`.",
          "type": "string"
        },
        "profile": {
          "description": "`debug` or `release`.",
          "type": "string"
        },
        "reproducible": {
          "description": "Fail the build if a second compilation of the same inputs produces a different digest (Proposal §11, `QQQ-1005`).",
          "type": "boolean"
        },
        "target": {
          "description": "Compilation target. `wasm32-wasip2` is the V1 default.",
          "type": "string"
        }
      },
      "title": "qqq-toml#Build",
      "type": "object"
    },
    "ByteSize": {
      "$id": "https://qqq.codes/schema/qqq-toml#ByteSize",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `ByteSize` table.",
      "properties": {},
      "title": "qqq-toml#ByteSize",
      "type": "object"
    },
    "Capabilities": {
      "$id": "https://qqq.codes/schema/qqq-toml#Capabilities",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Capabilities` table.",
      "properties": {
        "ai": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.ai]` — model providers and bounds."
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.clock]`."
        },
        "crypto": {
          "anyOf": [
            {
              "$ref": "#/$defs/CryptoCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.crypto]`."
        },
        "dns": {
          "anyOf": [
            {
              "$ref": "#/$defs/DnsCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.dns]`."
        },
        "env": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.env]`."
        },
        "fs": {
          "description": "`[[capabilities.fs]]` — one entry per preopened path.",
          "items": {
            "$ref": "#/$defs/FsCapability"
          },
          "type": "array"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.http]` — server and/or client HTTP."
        },
        "kv": {
          "anyOf": [
            {
              "$ref": "#/$defs/KvCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.kv]` — named stores."
        },
        "log": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.log]` — marker granting `log.write`."
        },
        "other": {
          "additionalProperties": true,
          "description": "Namespaces `Capability::all()` knows that have no typed struct yet. Kept so a declaration parses and can be *reported*; the host binds only what it models.…",
          "type": "object"
        },
        "queue": {
          "description": "`[[capabilities.queue]]` — one entry per queue.",
          "items": {
            "$ref": "#/$defs/QueueCapability"
          },
          "type": "array"
        },
        "secret": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.secret]` — named secret uses."
        },
        "sql": {
          "description": "`[[capabilities.sql]]` — one entry per database.",
          "items": {
            "$ref": "#/$defs/SqlCapability"
          },
          "type": "array"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[capabilities.trace]` — marker granting `trace.write`."
        }
      },
      "title": "qqq-toml#Capabilities",
      "type": "object"
    },
    "ClockCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#ClockCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `ClockCapability` table.",
      "properties": {
        "monotonic": {
          "description": "Whether the guest may read the monotonic clock. Defaults to **false**.",
          "type": "boolean"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Timezone name, for formatting only."
        },
        "wall": {
          "description": "Whether the guest may read the wall clock. Defaults to **false**.",
          "type": "boolean"
        }
      },
      "title": "qqq-toml#ClockCapability",
      "type": "object"
    },
    "Cors": {
      "$id": "https://qqq.codes/schema/qqq-toml#Cors",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Cors` table.",
      "properties": {
        "allow_credentials": {
          "description": "Send `Access-Control-Allow-Credentials: true`.",
          "type": "boolean"
        },
        "allow_headers": {
          "description": "Request headers the client may send.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allow_methods": {
          "description": "Methods advertised on a preflight. Empty advertises nothing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allow_origins": {
          "description": "The origins allowed to read responses. Empty allows nothing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expose_headers": {
          "description": "Response headers the browser may expose to script.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_age": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "How long a preflight may be cached, in seconds."
        }
      },
      "title": "qqq-toml#Cors",
      "type": "object"
    },
    "CryptoCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#CryptoCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `CryptoCapability` table.",
      "properties": {
        "aead": {
          "description": "Allowlisted AEAD constructions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hash": {
          "description": "Allowlisted hash algorithms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hmac": {
          "description": "Allowlisted HMAC algorithms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "random": {
          "description": "Whether the guest may draw randomness. Defaults to **false**: an unrequested CSPRNG is a covert channel.",
          "type": "boolean"
        },
        "secrets": {
          "description": "Named secrets the guest may **use** without reading.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sign": {
          "description": "Allowlisted signature algorithms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "qqq-toml#CryptoCapability",
      "type": "object"
    },
    "DependencyDetail": {
      "$id": "https://qqq.codes/schema/qqq-toml#DependencyDetail",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `DependencyDetail` table.",
      "properties": {
        "caps": {
          "description": "The capabilities this dependency **declares** it needs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exact": {
          "description": "Pin to exactly this version, ignoring the usual caret widening.",
          "type": "boolean"
        },
        "features": {
          "description": "Optional features to enable.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "An alternative source: `path+…`, `git+…`, `registry+…`."
        },
        "version": {
          "description": "The semver requirement, e.g. `1.2`, `^1.2.3`, `>=1.0, <2.0`.",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "qqq-toml#DependencyDetail",
      "type": "object"
    },
    "DnsCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#DnsCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `DnsCapability` table.",
      "properties": {
        "resolve": {
          "description": "Names the guest may resolve.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "qqq-toml#DnsCapability",
      "type": "object"
    },
    "EnvCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#EnvCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `EnvCapability` table.",
      "properties": {
        "allow": {
          "description": "Individually named variables. Never a blanket inherit.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "qqq-toml#EnvCapability",
      "type": "object"
    },
    "FsCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#FsCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `FsCapability` table.",
      "properties": {
        "mode": {
          "description": "`read-only`, `read-write` or `append-only`.",
          "enum": [
            "read-only",
            "append-only",
            "read-write"
          ],
          "type": "string"
        },
        "path": {
          "description": "The host path to preopen.",
          "type": "string"
        },
        "quota": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional quota, e.g. `5GiB`."
        }
      },
      "required": [
        "mode",
        "path"
      ],
      "title": "qqq-toml#FsCapability",
      "type": "object"
    },
    "HttpCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#HttpCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `HttpCapability` table.",
      "properties": {
        "cleartext": {
          "description": "Whether cleartext `http://` is permitted (maps to the `allow_cleartext` egress grant; default denies).",
          "type": "boolean"
        },
        "client": {
          "description": "Outbound hosts the component may reach, as `host:port` patterns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "redirects": {
          "description": "How many redirect hops the connector may follow (maps to the redirect-chain grant; default refuses; the protocol ceiling of 3 applies on top).",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "server": {
          "description": "Whether the component may receive inbound requests.",
          "type": "boolean"
        }
      },
      "title": "qqq-toml#HttpCapability",
      "type": "object"
    },
    "KvCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#KvCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `KvCapability` table.",
      "properties": {
        "stores": {
          "description": "Store names the guest may open.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "write": {
          "description": "Widen from read-only to `kv.write`. Default denies.",
          "type": "boolean"
        }
      },
      "title": "qqq-toml#KvCapability",
      "type": "object"
    },
    "Limits": {
      "$id": "https://qqq.codes/schema/qqq-toml#Limits",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Limits` table.",
      "properties": {
        "epoch_deadline_ms": {
          "description": "Wall-clock preemption backstop in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "fuel": {
          "description": "Deterministic instruction budget per request.",
          "minimum": 0,
          "type": "integer"
        },
        "max_instances": {
          "description": "Concurrency ceiling per worker.",
          "minimum": 0,
          "type": "integer"
        },
        "max_open_handles": {
          "description": "Maximum simultaneously open resource handles.",
          "minimum": 0,
          "type": "integer"
        },
        "max_poll_per_tick": {
          "description": "Impose a single scheduler tick after this many instances are polled.",
          "minimum": 0,
          "type": "integer"
        },
        "max_subrequests": {
          "description": "Maximum outbound subrequests one instance may drive.",
          "minimum": 0,
          "type": "integer"
        },
        "memory": {
          "description": "Memory cap, e.g. `128MiB`.",
          "type": "string"
        }
      },
      "title": "qqq-toml#Limits",
      "type": "object"
    },
    "LogCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#LogCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `LogCapability` table.",
      "properties": {},
      "title": "qqq-toml#LogCapability",
      "type": "object"
    },
    "Package": {
      "$id": "https://qqq.codes/schema/qqq-toml#Package",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Package` table.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One-line description, surfaced on the registry page."
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SPDX licence identifier."
        },
        "name": {
          "description": "Project name. Validated by `qqq-core`'s identifier rules.",
          "type": "string"
        },
        "version": {
          "description": "Semantic version of the project itself.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "qqq-toml#Package",
      "type": "object"
    },
    "QueueCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#QueueCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `QueueCapability` table.",
      "properties": {
        "direction": {
          "description": "Which direction this entry grants.",
          "enum": [
            "publish",
            "subscribe"
          ],
          "type": "string"
        },
        "name": {
          "description": "Logical name, used in diagnostics and audit rows.",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "name"
      ],
      "title": "qqq-toml#QueueCapability",
      "type": "object"
    },
    "RequestLimits": {
      "$id": "https://qqq.codes/schema/qqq-toml#RequestLimits",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `RequestLimits` table.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/TenantLimit"
            },
            {
              "type": "null"
            }
          ],
          "description": "The cap applied to a tenant with no entry in `per_tenant`."
        },
        "per_tenant": {
          "additionalProperties": {
            "$ref": "#/$defs/TenantLimit"
          },
          "description": "Per-tenant overrides, keyed by the **client's IP address**.",
          "type": "object"
        }
      },
      "title": "qqq-toml#RequestLimits",
      "type": "object"
    },
    "Route": {
      "$id": "https://qqq.codes/schema/qqq-toml#Route",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Route` table.",
      "properties": {
        "auth": {
          "anyOf": [
            {
              "enum": [
                "deny",
                "none",
                "bearer-jwt",
                "mtls",
                "signed-request"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "This route's authentication mode, overriding `default_auth`."
        },
        "handler": {
          "description": "The handler name in the guest.",
          "type": "string"
        },
        "kind": {
          "description": "How this route is served: plain HTTP, a WebSocket message loop, or a server-sent event stream.",
          "enum": [
            "http",
            "ws",
            "sse"
          ],
          "type": "string"
        },
        "methods": {
          "description": "The methods this route accepts. Empty is an error, not \"all\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "The path pattern, e.g. `/orders/:id`.",
          "type": "string"
        }
      },
      "required": [
        "handler",
        "path"
      ],
      "title": "qqq-toml#Route",
      "type": "object"
    },
    "SecretCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#SecretCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `SecretCapability` table.",
      "properties": {
        "secrets": {
          "description": "Secret references the guest may use, e.g. `env:DB_URL`. Never a blanket inherit; blank entries refuse like empty ones.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "qqq-toml#SecretCapability",
      "type": "object"
    },
    "Server": {
      "$id": "https://qqq.codes/schema/qqq-toml#Server",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Server` table.",
      "properties": {
        "cors": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cors"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[server.cors]` — the cross-origin policy, absent meaning no CORS at all."
        },
        "default_auth": {
          "description": "The authentication mode applied to a route that does not name one.",
          "enum": [
            "deny",
            "none",
            "bearer-jwt",
            "mtls",
            "signed-request"
          ],
          "type": "string"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestLimits"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[server.limits]` — the per-tenant request limits, absent meaning none."
        },
        "routes": {
          "description": "The route table. Empty means the project serves nothing.",
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServerTls"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[server.tls]` — the TLS identity, absent meaning cleartext (`SRV-021`)."
        },
        "websocket": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebsocketPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[server.websocket]` — the upgrade policy, absent meaning same-origin only with 1 MiB caps (`F-14`)."
        }
      },
      "title": "qqq-toml#Server",
      "type": "object"
    },
    "ServerTls": {
      "$id": "https://qqq.codes/schema/qqq-toml#ServerTls",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `ServerTls` table.",
      "properties": {
        "cert_file": {
          "description": "The PEM certificate chain file, leaf first.",
          "type": "string"
        },
        "key_file": {
          "description": "The PEM private key file.",
          "type": "string"
        }
      },
      "required": [
        "cert_file",
        "key_file"
      ],
      "title": "qqq-toml#ServerTls",
      "type": "object"
    },
    "SqlCapability": {
      "$id": "https://qqq.codes/schema/qqq-toml#SqlCapability",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `SqlCapability` table.",
      "properties": {
        "driver": {
          "description": "Driver selector, e.g. `postgres`.",
          "type": "string"
        },
        "execute": {
          "description": "Widen from query-only to `sql.execute`. Default denies.",
          "type": "boolean"
        },
        "host": {
          "description": "`host:port` the connector dials after vetting.",
          "type": "string"
        },
        "name": {
          "description": "Logical name, used in diagnostics and audit rows.",
          "type": "string"
        },
        "secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Secret reference for the connection string, e.g. `env:ORDERS_DB_URL`."
        }
      },
      "required": [
        "driver",
        "host",
        "name"
      ],
      "title": "qqq-toml#SqlCapability",
      "type": "object"
    },
    "TenantLimit": {
      "$id": "https://qqq.codes/schema/qqq-toml#TenantLimit",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `TenantLimit` table.",
      "properties": {
        "max_body_bytes": {
          "anyOf": [
            {
