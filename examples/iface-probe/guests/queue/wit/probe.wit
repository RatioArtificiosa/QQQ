// Probe world: queue only, so the component instantiates as soon as the
// host binds `qqq:queue`.
package qqq:iface-probe-queue@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-queue: func() -> string;
}

world probe {
  import qqq:queue/messaging@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
