// SPDX-License-Identifier: Apache-2.0

// Probe world: secrets only, so the component instantiates as soon as the
// host binds `qqq:secrets` — no other interface gates this guest.
package qqq:iface-probe-secrets@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-secrets: func() -> string;
}

world probe {
  import qqq:secrets/secret-use@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
