// QQQ key-value interface.
//
// Namespaced by the host, so a manifest granting `sessions` and `cart` gives a
// guest two isolated stores it cannot confuse — and cannot name a third.
//
// See Proposal §6.3 and Checklist `ABI-004`.
package qqq:kv@1.0.0;

/// Namespaced key-value access.
interface store {
  /// Why a key-value operation failed.
  variant kv-error {
    /// Neither `kv.read` nor `kv.write` was granted for this store.
    not-granted,
    /// The name is not in the manifest's store list.
    store-not-configured,
    /// A write was attempted on a store the manifest grants read-only.
    read-only,
    /// The key or value exceeded the host's per-entry limit.
    entry-too-large,
    /// The store's configured quota is exhausted.
    quota-exceeded,
    /// The backend failed.
    backend-failed(string),
  }

  /// Read a value.
  ///
  /// Returns `none` for a key that does not exist. Absence is not an error:
  /// treating it as one forces every caller to unwrap a "not found" error,
  /// which is how genuinely exceptional failures get swallowed.
  get: func(store: string, key: string) -> result<option<list<u8>>, kv-error>;

  /// Write a value, optionally expiring.
  ///
  /// `ttl-seconds` of `none` means no expiry. An explicit `none` rather than
  /// `0`-means-forever, because a zero TTL read as "expire immediately" is a
  /// classic and silent bug.
  set: func(store: string, key: string, value: list<u8>, ttl-seconds: option<u64>) -> result<_, kv-error>;

  /// Delete a key. Deleting an absent key succeeds.
  delete: func(store: string, key: string) -> result<_, kv-error>;

  /// Test for a key's presence without transferring its value.
  ///
  /// Cheaper than `get` for the common "does this exist?" check, and it does not
  /// pull a potentially large value across the ABI.
  exists: func(store: string, key: string) -> result<bool, kv-error>;

  /// List keys under a prefix, **sorted**.
  ///
  /// Sorted for the same reason directory listing is: unordered iteration is a
  /// source of nondeterminism that would break bit-identical replay
  /// (Proposal §10.5).
  keys: func(store: string, prefix: string, limit: u32) -> result<list<string>, kv-error>;

  /// Read several values in one call.
  ///
  /// Batch-first per the WIT style guide: a guest fetching ten keys should pay
  /// one ABI crossing, not ten.
  get-many: func(store: string, keys: list<string>) -> result<list<option<list<u8>>>, kv-error>;

  /// The names of stores the manifest configures.
  stores: func() -> list<string>;
}
