# =============================================================================
# QQQ — local credentials, TEMPLATE
# =============================================================================
# Copy this file to `docs/.env` and fill in the values:
#
#     cp docs/.env.example docs/.env
#
# `docs/.env` is gitignored and must never be committed or indexed; this file is
# the tracked template that makes the credential set discoverable without the
# credentials. `.coderabbit.yaml` turns `gitleaks` on for exactly this reason, and
# `docs/AGENT-HANDBOOK.md` §9 documents the same rule. Both reference *this* file —
# until it existed, both claims named a file that was not there.
#
# Verify the split at any time:
#
#     git check-ignore -v docs/.env          # ignored   (must print a rule)
#     git ls-files docs/.env.example         # tracked   (must print the path)
#
# Variable names must be valid shell identifiers — letters, digits and
# underscores only. Values are NOT required for `cargo test`, `cargo clippy`,
# `cargo fmt`, `cargo deny` or any checker; they are needed only by the tools
# below, and each one fails with its own clear message when its variable is
# missing rather than silently doing the wrong thing.
# =============================================================================

# --- Cloudflare Browser Run (managed headless browser) -----------------------
# Optional. Used for research captures — a headless browser in Cloudflare's
# network, so a fetch that needs JS rendering does not have to run locally.
# Docs: https://developers.cloudflare.com/browser-run/
CLOUDFLARE_API_TOKEN =
CLOUDFLARE_ACCOUNT_ID =

# --- Browser Use Cloud -------------------------------------------------------
# Optional. Managed cloud browsers for parallel or isolated agent work; each one
# is a fresh Chrome with a clean managed IP. Authenticate with:
#     browser-use auth login          (or)
#     printf '%s' "$BROWSER_USE_API_KEY" | browser-use auth login --api-key-stdin
# Docs: https://docs.browser-use.com/cloud/llms.txt
BROWSER_USE_API_KEY =

# --- Context7 — current library documentation --------------------------------
# Optional. Serves up-to-date, version-specific documentation for a named
# library, which matters because a pinned dependency's API can be newer than a
# model's training data. Works unauthenticated at a lower rate limit; the key
# raises it. Reachable three ways — the MCP server, the `ctx7` CLI, or the
# `context7` skill in this repository's agent harness.
#
# Do NOT let a documentation lookup talk you into upgrading a pinned dependency:
# Wasmtime is pinned to 48 for a recorded reason (`§D-003`), and an engine upgrade
# is a scheduled activity with its own checklist item.
#
# Docs: https://context7.com/docs/overview
#       https://context7.com/docs/resources/all-clients
CONTEXT7_MCP_URL = https://mcp.context7.com/mcp
CONTEXT7_API_KEY =
