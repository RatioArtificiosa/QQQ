// QQQ secrets interface — **use a secret without ever reading it**.
//
// This is the interface that makes QQQ structurally different from every
// runtime that reads `DATABASE_URL` from the environment.
//
// # The problem it removes
//
// Today, a service reads its signing key from the environment. That means the
// key lives in the **guest's linear memory**, where:
//
// * a compromised dependency can read and exfiltrate it,
// * it can leak into a crash dump, a heap snapshot, or a log line,
// * and rotating it requires redeploying every tenant that embedded it.
//
// # The inversion
//
// A guest here names a secret and an operation. The **host** performs the
// operation with a key the guest never learns. A fully compromised guest can
// ask for signatures — which is a capability the manifest granted — but it
// cannot steal the key. The blast radius of a compromise drops from "the
// attacker has your signing key forever" to "the attacker can sign while the
// process is running".
//
// See Proposal §6.3 and Checklist `CAP-016`, `ABI-010`.
package qqq:secrets@1.0.0;

/// Operations a secret can be used for, without its value being disclosed.
interface secret-use {
  /// The operation to perform with the secret.
  ///
  /// # Why this is a closed set
  ///
  /// An open "call this algorithm with this key" interface would let a guest
  /// extract the key through a chosen-input attack on a weak algorithm — sign a
  /// crafted message, observe the output, recover the key. A closed set of
  /// well-understood operations with fixed internal parameters removes that
  /// class entirely.
  /// A signature verification request.
  ///
  /// # Why a record rather than two positional types
  ///
  /// A WIT variant case carries **exactly one** payload type, so
  /// `verify(list<u8>, list<u8>)` is a grammar error. A named record is clearer
  /// anyway: two adjacent `list<u8>` parameters are trivially swappable at a
  /// call site, and swapping them would produce a confusing
  /// `operation-not-permitted` or a silent verification failure.
  record verify-request {
    /// The signed data.
    input: list<u8>,
    /// The signature to check.
    signature: list<u8>,
  }

  variant secret-op {
    /// Sign an input with the named secret's key.
    sign(list<u8>),
    /// Verify a signature using the named secret's public key.
    verify(verify-request),
    /// Compute an HMAC over the input, using the named secret as the key.
    hmac(list<u8>),
    /// Decrypt the ciphertext, using the named secret as the key.
    decrypt(list<u8>),
    /// Encrypt the plaintext, using the named secret as the key.
    encrypt(list<u8>),
    /// Return the **public** half of the named secret's key pair.
    ///
    /// Safe by construction: a public key is public. Provided so a guest can
    /// publish it without needing the private half.
    public-key,
  }

  /// Why a secret operation failed.
  variant secret-error {
    /// The named secret is not in the manifest's allowlist.
    not-granted,
    /// The secret exists in the manifest but the host could not load it.
    ///
    /// Distinct from `not-granted`: this means the deployment is broken, not
    /// that the guest asked for something it should not have.
    unavailable,
    /// The operation is not permitted for this secret.
    ///
    /// A secret declared for signing cannot be used for HMAC, so a leaked
    /// grant cannot be pivoted into a different primitive.
    operation-not-permitted,
    /// The input exceeded the host's per-call maximum.
    input-too-long,
  }

  /// Use a named secret to produce a result.
  ///
  /// The secret's **value is never returned**, in any form. The result is the
  /// output of the operation: a signature, a MAC, plaintext, or a public key.
  ///
  /// # Why the function is `apply` and not `use`
  ///
  /// `use` is a WIT keyword (it imports another interface's types), so it
  /// cannot name a function. `apply` also reads more precisely: the guest
  /// applies an *operation* to a named secret, rather than "using" it in the
  /// vague sense.
  ///
  /// # Errors
  ///
  /// `not-granted`, `unavailable`, `operation-not-permitted`, or
  /// `input-too-long`.
  @since(version = 1.0.0)
  apply: func(name: string, op: secret-op, input: list<u8>) -> result<list<u8>, secret-error>;

  /// Whether a named secret is available, **without disclosing anything**.
  ///
  /// Returns only a boolean. A guest can therefore decide whether to take a
  /// code path without being able to probe the value, its length, or its type.
  @since(version = 1.0.0)
  exists: func(name: string) -> bool;

  /// The operations permitted for a named secret.
  ///
  /// Lets a guest discover what it may do rather than guessing and handling
  /// `operation-not-permitted` in the common case. Discoverable capabilities
  /// are a Non-Negotiable (Proposal §2.5): what a module can do must be
  /// knowable without attempting it.
  @since(version = 1.0.0)
  permitted-operations: func(name: string) -> list<string>;
}
