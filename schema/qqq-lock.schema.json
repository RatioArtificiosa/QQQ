{
  "$defs": {
    "BuildConfig": {
      "$id": "https://qqq.codes/schema/qqq-lock#BuildConfig",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `BuildConfig` record.",
      "properties": {
        "caps": {
          "description": "The declared capability names, sorted, as the manifest resolved them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source language: `rust`, `ts`, `go`, `python` or `cpp`."
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "`debug` or `release`."
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compilation target."
        }
      },
      "title": "qqq-lock#BuildConfig",
      "type": "object"
    },
    "CapabilityDelta": {
      "$id": "https://qqq.codes/schema/qqq-lock#CapabilityDelta",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `CapabilityDelta` record.",
      "properties": {
        "added": {
          "description": "Capabilities gained.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "package": {
          "description": "The package.",
          "type": "string"
        },
        "removed": {
          "description": "Capabilities lost.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "added",
        "package",
        "removed"
      ],
      "title": "qqq-lock#CapabilityDelta",
      "type": "object"
    },
    "DependencyChange": {
      "$id": "https://qqq.codes/schema/qqq-lock#DependencyChange",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `DependencyChange` record.",
      "properties": {
        "caps_added": {
          "description": "Capabilities that appeared.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "caps_removed": {
          "description": "Capabilities that disappeared.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version before, absent when added."
        },
        "kind": {
          "description": "What happened.",
          "enum": [
            "added",
            "removed",
            "updated",
            "modified-in-place"
          ],
          "type": "string"
        },
        "name": {
          "description": "The package name.",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The version after, absent when removed."
        }
      },
      "required": [
        "caps_added",
        "caps_removed",
        "kind",
        "name"
      ],
      "title": "qqq-lock#DependencyChange",
      "type": "object"
    },
    "LockDiff": {
      "$id": "https://qqq.codes/schema/qqq-lock#LockDiff",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `LockDiff` record.",
      "properties": {
        "capability_changes": {
          "description": "Only the packages whose **authority** changed.",
          "items": {
            "$ref": "#/$defs/CapabilityDelta"
          },
          "type": "array"
        },
        "changes": {
          "description": "Every changed package.",
          "items": {
            "$ref": "#/$defs/DependencyChange"
          },
          "type": "array"
        }
      },
      "required": [
        "capability_changes",
        "changes"
      ],
      "title": "qqq-lock#LockDiff",
      "type": "object"
    },
    "LockPackage": {
      "$id": "https://qqq.codes/schema/qqq-lock#LockPackage",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `LockPackage` record.",
      "properties": {
        "caps": {
          "description": "The capabilities this package declares.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The digest of the component artifact."
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The SPDX licence identifier."
        },
        "name": {
          "description": "The package name, possibly scoped: `qqqai/json`, `@org/pkg`.",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it came from."
        },
        "version": {
          "description": "The resolved version.",
          "type": "string"
        },
        "wit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The digest of the generated WIT interface."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "qqq-lock#LockPackage",
      "type": "object"
    },
    "Metadata": {
      "$id": "https://qqq.codes/schema/qqq-lock#Metadata",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `Metadata` record.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "The build configuration the hash covers — `CON-005`."
        },
        "generated-by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What wrote it, so a bug report can name the version."
        },
        "lockfile-hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The covering hash over every resolved package **and the build config**."
        }
      },
      "title": "qqq-lock#Metadata",
      "type": "object"
    }
  },
  "$id": "https://qqq.codes/schema/qqq-lock",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The QQQ lockfile, `qqq.lock`. `lockfile-hash` covers every resolved package **and** the recorded build config (CON-005).",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Metadata",
      "description": "Metadata, including the covering hash."
    },
    "package": {
      "description": "The resolved packages, sorted by name then version.",
      "items": {
        "$ref": "#/$defs/LockPackage"
      },
      "type": "array"
    },
    "version": {
      "description": "The format version.",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "qqq-lock",
  "type": "object"
}
