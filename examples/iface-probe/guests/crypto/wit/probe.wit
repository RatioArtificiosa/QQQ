// Probe world: crypto hmac/aead/signing, so the component instantiates as
// soon as the host binds `qqq:crypto`.
package qqq:iface-probe-crypto@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-crypto: func() -> string;
}

world probe {
  import qqq:crypto/hmac@1.0.0;
  import qqq:crypto/aead@1.0.0;
  import qqq:crypto/signing@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
