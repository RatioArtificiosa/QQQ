// Probe world: env only, so the component instantiates as soon as the host
// binds `qqq:env`.
package qqq:iface-probe-env@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-env: func() -> string;
}

world probe {
  import qqq:env/environment@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
