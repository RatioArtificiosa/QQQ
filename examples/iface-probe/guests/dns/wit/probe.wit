// Probe world: dns only, so the component instantiates as soon as the
// host binds `qqq:dns`.
package qqq:iface-probe-dns@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-dns: func() -> string;
}

world probe {
  import qqq:dns/resolver@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
