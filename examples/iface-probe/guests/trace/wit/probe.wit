// Probe world: trace only, so the component instantiates as soon as the host
// binds `qqq:trace`.
package qqq:iface-probe-trace@1.0.0;

/// One scenario per interface, returning a summary the host asserts on.
interface probe-api {
  probe-trace: func() -> string;
}

world probe {
  import qqq:trace/tracing@1.0.0;

  export probe-api;
  export qqq:http/incoming-handler@1.0.0;
}
